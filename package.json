{
    "name": "canvade-openrider",
    "version": "1.0.0",
    "main": "main.ts",
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit && tsc -p test",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
        "test": "vitest",
        "coverage": "vitest run --coverage --coverage.include=src/**"
    },
    "keywords": [],
    "author": "",
    "license": "GPL-3.0",
    "description": "OpenRider, ported on the canvade engine",
    "devDependencies": {
        "@vitest/coverage-v8": "^3.2.7",
        "canvade": "file:../canvade",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2",
        "vitest": "^3.2.7"
    }
}
